# Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=
# Your own Telegram user id (admin: /kill, /resume, trade confirmations). Get it from @userinfobot
ADMIN_CHAT_ID=

# Bitget DEMO API key (Read + Trade). Used only with --paper-trading.
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# Agent execution: "confirm" = human taps Confirm in Telegram, "paper" = straight to demo account
AGENT_MODE=confirm
# USDT risked per agent trade (distance to stop x qty)
AGENT_RISK_USDT=10

DASHBOARD_PORT=8787

# Market-hours calendar: "us" = calls Mon–Fri 04:00–16:00 New York (default).
# "always" = calendar off, for weekend demos only (the bot shows "Demo mode").
SESSION_MODE=us

# Public https base URL of this server (e.g. a Cloudflare tunnel). Enables the Telegram Mini App at <url>/app.
WEBAPP_URL=
